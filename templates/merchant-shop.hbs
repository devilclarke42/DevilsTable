<div class="dt-shop">
  <header class="dt-merchant-header">
    <img class="dt-merchant-portrait" data-merchant-portrait src="{{portrait}}" alt="Portrait of {{merchant}}" width="72" height="72">
    <div class="dt-merchant-identity"><h2>{{merchant}}</h2>
      <div class="dt-merchant-context">{{#if catalogue}}<p><img class="dt-category-icon" src="{{catalogue.icon}}" alt=""> {{catalogue.name}}</p>{{/if}}<p>Status: <strong>{{availability}}</strong></p></div>
    </div>
  </header>
  {{#if canAdmin}}<nav class="dt-manager-tabs" aria-label="Merchant view">
    <button type="button" data-action="setupMerchant">Merchant Builder</button>
    <button type="button" data-action="toggleAdministration">{{#if administrationOpen}}Return to Inventory{{else}}Administration{{/if}}</button>
  </nav>{{/if}}
  {{#if administrationOpen}}
  <section class="dt-administration" aria-label="Merchant administration">
    <h3>Merchant Summary — {{merchant}}</h3>
    {{#if adminError}}<p role="alert">{{adminError}}</p>{{/if}}
    {{#if administration}}
      <p>{{administration.catalogue}}</p>
      <dl class="dt-summary-card">{{#each administration.rows}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>
      {{#if administration.unpriced}}<p>{{administration.unpriced}} entries could not be valued; inventory value excludes them.</p>{{/if}}
      <p>Initial float: {{administration.floatStatus}}. Values use base item/offer prices. Lifetime trade totals come from character relationships.</p>
      <details><summary>Economy configuration</summary>
        {{#each administration.fields}}<label>{{label}} <select name="{{key}}">{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/each}}
        <button type="button" data-action="saveEconomy" {{#if adminBusy}}disabled{{/if}}>Save economy settings</button>
        <p>These inputs determine the one-time initial cash float. Changing them does not refill an existing wallet.</p>
      </details>
      <button type="button" data-action="setupMerchant">Open Merchant Builder</button>
      <button type="button" data-action="emptyStock" {{#if adminBusy}}disabled{{/if}}>Empty Stock</button>
    {{/if}}
  </section>
  {{else}}
  <p role="status" aria-live="polite">{{message}}</p>
  <div class="dt-shop-controls">
    <label>Search <input name="search" type="search" value="{{query}}" maxlength="100"></label>
    <button type="button" data-action="search">Search</button>
    <button type="button" data-action="refresh">Refresh stock</button>
  </div>
  <div class="dt-shop-categories" aria-label="Stock filters">
    <button type="button" data-action="category" data-category="">All</button>
    {{#each categories}}<button type="button" data-action="category" data-category="{{id}}" aria-pressed="{{selected}}"><img class="dt-category-icon" src="{{icon}}" alt=""> {{name}}</button>{{/each}}
  </div>
  <div class="dt-shop-grid">
    <section class="dt-shop-stock" aria-label="Available stock">
      {{#each items}}
        <article class="dt-shop-item" data-offer-id="{{id}}" {{#if hidden}}hidden{{/if}}>
          <img src="{{img}}" alt="" loading="lazy"><div><h3>{{name}}</h3><p>{{description}}</p>
            <p>{{priceLabel}} per {{saleUnit}} · {{#if unlimited}}Unlimited ({{quantity}} per checkout){{else}}{{quantity}} available{{/if}}</p></div>
          <div class="dt-item-actions"><button type="button" data-action="add" data-id="{{id}}">Add</button>
          <button type="button" data-action="steal" data-id="{{id}}" {{#unless @root.canInteract}}disabled{{/unless}}>Attempt theft</button></div>
        </article>
      {{/each}}<p data-no-matches {{#unless noMatches}}hidden{{/unless}}>No matching public offers.</p>
    </section>
    <aside class="dt-shop-basket" aria-label="Your basket"><h3>Basket</h3>
      {{#each basket}}<p>{{count}} × {{name}} — {{subtotalLabel}}
        <button type="button" data-action="remove" data-id="{{id}}" aria-label="Remove one {{name}}">Remove one</button></p>
      {{else}}<p>Empty. Items are not reserved.</p>{{/each}}
      <h4>Items you are selling</h4>
      {{#each sales}}<p>{{count}} × {{name}} — {{subtotalLabel}} <button type="button" data-action="unsell" data-id="{{id}}">Remove one</button></p>{{/each}}
      <p>{{characterName}} · Available: {{fundsLabel}}</p>
      {{#if fundsError}}<p role="alert">{{fundsError}}</p>{{/if}}
      <p>Subtotal: {{originalLabel}}</p>
      <p>Modifiers ({{stacking}}): {{#each modifiers}}<span>{{name}} {{label}} </span>{{/each}}</p>
      <p>Adjusted purchases: {{adjustedLabel}}</p>
      <p><strong>Total: {{totalLabel}}</strong></p>
      <button type="button" data-action="negotiate" {{#unless canInteract}}disabled{{/unless}}>Request negotiation</button>
      <button type="button" data-action="checkout" {{#unless canCheckout}}disabled{{/unless}}>Request checkout</button>
      <p>The GM checks prices, funds and stock again before transferring goods and currency.</p>
    </aside>
  </div>
  <details><summary>Sell from your selected character</summary>
    <p>Unequip and unattune items; empty containers and remove nested items before selling.</p>
    {{#each sellItems}}<p>{{name}} · Offer {{priceLabel}} each · {{quantity}} owned <button type="button" data-action="sell" data-id="{{id}}">Offer one</button></p>{{else}}<p>Select a character with priced physical items, then Refresh stock.</p>{{/each}}
  </details>
  {{/if}}
</div>
