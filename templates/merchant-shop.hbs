<div class="dt-shop">
  <header><h2>{{merchant}}</h2><p>Status: <strong>{{availability}}</strong></p></header>
  <p role="status" aria-live="polite">{{message}}</p>
  <div class="dt-shop-controls">
    <label>Search <input name="search" type="search" value="{{query}}" maxlength="100"></label>
    <button type="button" data-action="search">Search</button>
    <button type="button" data-action="refresh">Refresh stock</button>
  </div>
  <div class="dt-shop-categories" aria-label="Stock filters">
    <button type="button" data-action="category" data-category="">All</button>
    {{#each categories}}<button type="button" data-action="category" data-category="{{id}}" aria-pressed="{{selected}}">{{id}}</button>{{/each}}
  </div>
  <div class="dt-shop-grid">
    <section class="dt-shop-stock" aria-label="Available stock">
      {{#each items}}
        <article class="dt-shop-item">
          <img src="{{img}}" alt="" loading="lazy"><div><h3>{{name}}</h3><p>{{description}}</p>
            <p>{{price.value}} {{price.denomination}} per {{saleUnit}} · {{quantity}} available</p></div>
          <button type="button" data-action="add" data-id="{{id}}">Add</button>
        </article>
      {{else}}<p>No matching public offers.</p>{{/each}}
    </section>
    <aside class="dt-shop-basket" aria-label="Your basket"><h3>Basket</h3>
      {{#each basket}}<p>{{count}} × {{name}} — {{subtotalLabel}}
        <button type="button" data-action="remove" data-id="{{id}}" aria-label="Remove one {{name}}">Remove one</button></p>
      {{else}}<p>Empty. Items are not reserved.</p>{{/each}}
      <h4>Items you are selling</h4>
      {{#each sales}}<p>{{count}} × {{name}} — {{subtotalLabel}} <button type="button" data-action="unsell" data-id="{{id}}">Remove one</button></p>{{/each}}
      <p>{{characterName}} · Available: {{fundsLabel}}</p>
      {{#if fundsError}}<p role="alert">{{fundsError}}</p>{{/if}}
      <p><strong>Total: {{totalLabel}}</strong></p>
      <button type="button" data-action="checkout" {{#unless canCheckout}}disabled{{/unless}}>Request checkout</button>
      <p>The GM checks prices, funds and stock again before transferring goods and currency.</p>
    </aside>
  </div>
  <details><summary>Sell from your selected character</summary>
    <p>Unequip and unattune items; empty containers and remove nested items before selling.</p>
    {{#each sellItems}}<p>{{name}} · Offer {{priceLabel}} each · {{quantity}} owned <button type="button" data-action="sell" data-id="{{id}}">Offer one</button></p>{{else}}<p>Select a character with priced physical items, then Refresh stock.</p>{{/each}}
  </details>
</div>
