<div class="dt-merchant-builder">
  <header><h2>Merchant Builder — {{actorName}}</h2><p role="status">{{message}}</p></header>
  <nav class="dt-manager-tabs" role="tablist" aria-label="Merchant Builder steps">
    <button type="button" role="tab" data-action="selectTab" data-builder-tab="setup" aria-selected="{{tabs.setup}}">1. Setup</button>
    <button type="button" role="tab" data-action="selectTab" data-builder-tab="identity" aria-selected="{{tabs.identity}}">2. Identity</button>
    <button type="button" role="tab" data-action="selectTab" data-builder-tab="stock" aria-selected="{{tabs.stock}}">3. Stock</button>
    <button type="button" role="tab" data-action="selectTab" data-builder-tab="services" aria-selected="{{tabs.services}}">4. Services</button>
    <button type="button" role="tab" data-action="selectTab" data-builder-tab="cash" aria-selected="{{tabs.cash}}">5. Cash</button>
    <button type="button" role="tab" data-action="selectTab" data-builder-tab="manage" aria-selected="{{tabs.manage}}">6. Manage</button>
  </nav>
  <p>Jump to any tab or use Back / Next. Settings remain manually editable; navigating never applies changes.</p>
  <section role="tabpanel" data-builder-panel="setup" {{#unless tabs.setup}}hidden{{/unless}}>
  <fieldset {{#if busy}}disabled{{/if}}><legend>NPC and reusable templates</legend>
    <div class="dt-merchant-builder-fields">
      <label>NPC <select name="builderNpc"><option value="">Choose an NPC</option>{{#each npcs}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <label>Template <select name="builderTemplate"><option value="">Choose a preset</option>{{#each templates}}<option value="{{key}}" {{#if selected}}selected{{/if}} {{#if unavailable}}disabled{{/if}}>{{origin}} — {{name}}</option>{{/each}}</select></label>
      <button type="button" data-action="applyTemplate">Apply Template to Draft</button>
      <label>Custom template name <input name="templateName" maxlength="100" placeholder="Name this reusable preset"></label>
      <button type="button" data-action="saveTemplate">Save as Template</button>
    </div>
  </fieldset>
<fieldset {{#if busy}}disabled{{/if}}><legend>Merchant configuration</legend>
      <div class="dt-merchant-builder-fields">
        {{#each selects}}<label>{{label}} <select name="{{key}}" data-config>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/each}}
        <label>Shop pricing modifier (%) <input data-config name="pricingModifier" type="number" min="-100" max="500" step="0.01" value="{{draft.pricingModifier}}"></label>
        <label><input data-config name="infiniteFunds" type="checkbox" {{#if draft.infiniteFunds}}checked{{/if}}> Infinite Funds</label>
        <label><input data-config name="infiniteStock" type="checkbox" {{#if draft.infiniteStock}}checked{{/if}}> Infinite Stock</label>
      </div>
      <details><summary>Manual profile overrides, relationships and notes</summary>
      <div class="dt-merchant-builder-fields">
        {{#each advancedSelects}}<label>{{label}} <select name="{{key}}" data-config>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{/each}}
        <label>New customer modifier (%) <input data-config name="relationshipModifier" type="number" min="-100" max="500" step="0.01" value="{{draft.relationshipModifier}}"></label>
      </div>
      <p>Relationship defaults affect new customers only. Restock preferences do not schedule automatic restocking.</p>
      <label>Merchant notes (GM only)<textarea data-config name="notes" maxlength="10000" rows="5">{{draft.notes}}</textarea></label>
      </details>
      <p data-estimate="dirty"></p>
      <p>Save also adds eligible catalogue-default services. Existing service overrides and removals are preserved. Manage services in the Services tab.</p>
      <button type="button" data-action="save">Save / Convert NPC</button>
      <button type="button" data-action="reload">Reload NPC</button>
    </fieldset>

    <button type="button" data-action="generateNotes" {{#if busy}}disabled{{/if}}>Regenerate Notes</button>
  </section>
  <section role="tabpanel" data-builder-panel="identity" {{#unless tabs.identity}}hidden{{/unless}}>
    <h3>Actor information — read only</h3>
    <p>These values come directly from Foundry and D&amp;D5e. Edit the Actor to change them; this panel updates automatically.</p>
    <img data-identity-portrait class="dt-merchant-portrait" src="{{nativeIdentity.portrait}}" alt="Actor portrait" width="72" height="72">
    <dl class="dt-identity-native">
      <dt>Name</dt><dd data-identity-read="name">{{nativeIdentity.name}}</dd>
      <dt>Species / Race</dt><dd data-identity-read="species">{{nativeIdentity.species}}</dd>
      <dt>Creature type</dt><dd data-identity-read="creature">{{nativeIdentity.creature}}</dd>
      <dt>Class</dt><dd data-identity-read="classes">{{nativeIdentity.classes}}</dd>
      <dt>Size</dt><dd data-identity-read="size">{{nativeIdentity.size}}</dd>
      <dt>Alignment</dt><dd data-identity-read="alignment">{{nativeIdentity.alignment}}</dd>
      <dt>Prototype token</dt><dd data-identity-read="prototypeToken">{{nativeIdentity.prototypeToken}}</dd>
      <dt>Token image</dt><dd data-identity-read="tokenImage">{{nativeIdentity.tokenImage}}</dd>
      <dt>Scene tokens</dt><dd data-identity-read="tokens">{{nativeIdentity.tokens}}</dd>
      <dt>Biography summary</dt><dd data-identity-read="biography">{{nativeIdentity.biography}}</dd>
      <dt>System Tags</dt><dd data-identity-read="systemTags"></dd>
    </dl>
    <fieldset {{#if generationBlocked}}disabled{{/if}}><legend>Merchant information — editable</legend>
      <p>Save / Convert in Setup first. These fields describe the business; they do not rename the NPC or its tokens.</p>
      <label>Business name <input data-merchant-identity="businessName" maxlength="160" value="{{identity.businessName}}"></label>
      <label>Merchant title <input data-merchant-identity="merchantTitle" maxlength="160" value="{{identity.merchantTitle}}"></label>
      <label>Merchant Tags (comma separated, GM only) <input data-merchant-identity="merchantTags" value="{{merchantTags}}" placeholder="rural, honest, local-produce"></label>
      <label>Public description <textarea data-merchant-identity="publicDescription" maxlength="2000" rows="3">{{identity.publicDescription}}</textarea></label>
      <label>Shop description <textarea data-merchant-identity="shopDescription" maxlength="2000" rows="3">{{identity.shopDescription}}</textarea></label>
      <p>Descriptions, business name and title are player-visible. Tags are private metadata and have no automatic gameplay effect.</p>
      <button type="button" data-action="saveIdentity">Save Merchant Identity</button>
    </fieldset>
  </section>
  <section role="tabpanel" data-builder-panel="services" {{#unless tabs.services}}hidden{{/unless}}>
    {{#if hasActor}}<fieldset {{#if generationBlocked}}disabled{{/if}}><legend>Services</legend>{{{servicesHTML}}}</fieldset>{{else}}<p>Select an NPC in Setup first.</p>{{/if}}
  </section>
  <section role="tabpanel" data-builder-panel="stock" {{#unless tabs.stock}}hidden{{/unless}}>
      <h3>Expected generation</h3>
      <dl><dt>Stock size</dt><dd data-estimate="size"></dd><dt>Stock value</dt><dd data-estimate="value"></dd><dt>Initial float range</dt><dd data-estimate="cash"></dd><dt>Rare item probability</dt><dd data-estimate="rare"></dd><dt>Category distribution (expected goods)</dt><dd data-estimate="distribution"></dd></dl>
      <p data-estimate="coverage"></p>

    <button type="button" data-action="generateStock" {{#if generationBlocked}}disabled{{/if}}>Generate / Regenerate Stock</button>
    <p>Save changes in Setup first. Review the rolled items before applying; existing goods are preserved.</p>
  <section data-preview="stock" {{#unless stock}}hidden{{/unless}}><h3>Stock preview</h3>
    <p>{{stock.profileName}} · {{stock.added}} distinct goods to add · Estimated base value: {{stock.valueLabel}}</p>
    <p>Cash plan: {{float.label}} {{#if float.replacement}}(replaces the current wallet){{/if}}. Use Cash to reroll or override it.</p>
    <details><summary>Review items and quantities</summary><ul>{{#each stock.items}}<li><label>{{name}} — {{priceLabel}} each <input type="number" min="0" step="1" data-stock-id="{{id}}" value="{{quantity}}" {{#if skip}}disabled{{/if}}></label>{{#if skip}}Already stocked; preserved{{/if}}</li>{{/each}}</ul><p>Set a quantity to zero to omit a proposed addition.</p><button type="button" data-action="editStock" {{#if busy}}disabled{{/if}}>Update Stock Preview</button></details>
    <button type="button" data-action="applyStock" {{#if stockBlocked}}disabled{{/if}}>Confirm and Apply Stock</button>
  </section>

  </section>
  <section role="tabpanel" data-builder-panel="cash" {{#unless tabs.cash}}hidden{{/unless}}>
    <h3>Merchant cash</h3><p>Current wallet: <strong>{{cashLabel}}</strong></p>
    <p>Generate a cash preview, manually override its amount if desired, then confirm Apply Float.
    Applying replaces the existing wallet with the displayed total; it does not add that amount on top.</p>
    <button type="button" data-action="generateFloat" {{#if generationBlocked}}disabled{{/if}}>Generate / Reroll Cash Preview</button>
    <p>Save Setup first. Infinite Funds must be disabled to generate physical cash.</p>
  <section data-preview="float" {{#unless float}}hidden{{/unless}}><h3>Float preview</h3><p>{{float.label}} {{#if float.replacement}}— replacement requested{{/if}}</p>
    {{#if float.generated}}<label>Final amount <input name="floatValue" type="number" min="0" step="0.01" value="{{float.amount}}"></label>
    <label>Denomination <select name="floatDenomination"><option value="gp">gp</option><option value="sp">sp</option><option value="cp">cp</option><option value="ep">ep</option><option value="pp">pp</option></select></label>
    <button type="button" data-action="editFloat" {{#if busy}}disabled{{/if}}>Update Float Preview</button>{{/if}}
    <button type="button" data-action="applyFloat" {{#if floatBlocked}}disabled{{/if}}>Confirm and Apply Float Only</button>
  </section>

  </section>
  <section role="tabpanel" data-builder-panel="manage" {{#unless tabs.manage}}hidden{{/unless}}>
      <details open><summary>Current merchant statistics</summary>
        {{#if summaryError}}<p role="alert">{{summaryError}}</p>{{/if}}
        {{#if summary}}<dl class="dt-summary-card">{{#each summary.rows}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl>{{else}}<p>Save / Convert to display merchant statistics. Existing inventory and currency will be preserved.</p>{{/if}}
      </details>

    <button type="button" data-action="empty" {{#if busy}}disabled{{/if}}>Empty Stock…</button>
    <button type="button" data-action="advanced">Advanced Trade Settings / Recovery</button>
    <details><summary>Reset NPC to a normal NPC</summary>
      <p>Permanently remove this NPC's merchant configuration, relationships, notes and transaction history.
      Inventory and currency remain. Resolve any interrupted trade first.</p>
      <button type="button" data-action="resetMerchant" {{#if busy}}disabled{{/if}}>Reset Merchant and Clear History…</button>
    </details>
  </section>
  <footer class="dt-manager-tabs">
    <button type="button" data-action="stepTab" data-step="-1">Back</button>
    <button type="button" data-action="stepTab" data-step="1">Next</button>
  </footer>
</div>
