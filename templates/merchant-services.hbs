<div class="dt-services-manager">
  <h2>{{name}} — Services</h2>
  <p>Services are separate from inventory. Save the NPC's catalogue and economic profile in the Builder first.</p>
  <fieldset {{#if busy}}disabled{{/if}}><legend>Generate from selected categories</legend>
    {{#each categories}}<label><input type="checkbox" name="serviceCategory" value="{{id}}" {{#if checked}}checked{{/if}}>{{name}}</label>{{else}}<p>No service categories are defined for this catalogue.</p>{{/each}}
    <button type="button" data-action="generateServices">Preview / Generate Offers…</button>
  </fieldset>
  <fieldset {{#if busy}}disabled{{/if}}><legend>Offerings and manual overrides</legend>
    <div class="dt-service-filters">
      <label>Search services <input type="search" data-service-filter="query"></label>
      <label>Category <select data-service-filter="category"><option value="">All categories</option>{{#each categories}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
      <label>Filter <select data-service-filter="status"><option value="">All services</option><option value="offered">Offered</option><option value="enabled">Enabled</option><option value="disabled">Disabled</option><option value="unavailable">Unavailable</option></select></label>
    </div>
    {{#each groups}}<section data-service-group="{{id}}"><h3>{{name}}</h3>
    {{#each services}}<article data-service-row="{{id}}" data-category="{{category}}" data-search="{{search}}" data-eligible="{{eligible}}"><h3>{{name}}</h3><p>{{description}}</p><p>Unit: {{saleUnit}} · Suggested duration: {{duration}} · Recommended base range: {{rangeLabel}}</p>
      <label><input type="checkbox" name="offered" {{#if offered}}checked{{/if}}>Offer this service</label>
      <label><input type="checkbox" name="enabled" {{#if enabled}}checked{{/if}}>Enabled</label>
      <label><input type="checkbox" name="available" {{#if available}}checked{{/if}}>Available now (subject to profile and character requirements)</label>
      {{#unless eligible}}<p>Unavailable for the merchant's current catalogue or economic profile.</p>{{/unless}}
      <label>Unit price <input name="price" type="number" min="0" step="0.01" value="{{price.value}}"></label>
      <select name="denomination" aria-label="Price denomination">{{#each denominations}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select>
      <p>Purchased: {{purchased}} · Revenue: {{revenue}} · Last purchase: {{last}} · Popularity: {{popularity}}</p>
    </article>{{/each}}</section>{{else}}<p>No services defined. Use the shared JSON editor below or install a service provider.</p>{{/each}}
    <button type="button" data-action="saveServices">Save Service Offerings</button>
  </fieldset>
  <details><summary>Shared world service definitions (JSON)</summary>
    <p>Data only; no programming required. See docs/MERCHANT_SERVICES.md for the complete format and an example. Permanent IDs must never be reused. These definitions are shared by all merchants.</p>
    <textarea name="serviceDefinitions" rows="18" aria-label="World service definition JSON">{{definitions}}</textarea>
    <button type="button" data-action="saveServiceDefinitions" {{#if busy}}disabled{{/if}}>Validate and Save Definitions…</button>
  </details>
</div>
