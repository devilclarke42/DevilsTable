<div class="dt-shop dt-review">
  <h2>Checkout request</h2>
  <p><strong>Merchant:</strong> {{merchant}}<br><strong>Character:</strong> {{character}}<br>
    <strong>Player:</strong> {{claimedUser}}</p>
  <p class="dt-warning">{{note}}</p>
  <h3>Basket</h3>
  {{#each basket}}<div data-trade-line data-id="{{id}}" data-direction="{{direction}}">
    <strong>{{direction}}: {{name}}</strong> ({{priceLabel}} each)
    <label>Quantity <input name="quantity" type="number" min="0" step="1" value="{{quantity}}"></label>
    <label>Unit price (cp) <input name="copper" type="number" min="0" step="1" value="{{copper}}"></label>
  </div>{{/each}}
  <button type="button" data-action="recalculate">Recalculate offer</button>
  <p><strong>Request total:</strong> {{totalLabel}}</p>
  <details><summary>Character currency (read-only)</summary>
  <ul>{{#each currency}}<li>{{@key}}: {{this}}</li>{{/each}}</ul>
  </details>
  <details><summary>Currency settlement</summary>
  <table><thead><tr><th>Coin</th><th>Character before</th><th>After</th><th>Merchant before</th><th>After</th></tr></thead>
  <tbody>{{#each paymentRows}}<tr><td>{{coin}}</td><td>{{pcBefore}}</td><td>{{pcAfter}}</td><td>{{gmBefore}}</td><td>{{gmAfter}}</td></tr>{{/each}}</tbody></table>
  </details>
  <p>Approval transfers these goods and coins. Rejection records a private receipt without moving them.</p>
  <div class="dt-shop-controls"><button type="button" data-action="approve">Approve request</button>
    <button type="button" data-action="reject">Reject</button><button type="button" data-action="dismiss">Close</button></div>
</div>
