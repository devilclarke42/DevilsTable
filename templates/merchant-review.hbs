<div class="dt-shop dt-review">
  <h2>Checkout request</h2>
  <p><strong>Merchant:</strong> {{merchant}}<br><strong>Character:</strong> {{character}}<br>
    <strong>Claimed requester:</strong> {{claimedUser}}</p>
  <p class="dt-warning">{{note}}</p>
  <h3>Basket</h3><ul>{{#each basket}}<li>{{quantity}} × {{name}} — {{copper}} cp per unit</li>{{/each}}</ul>
  <p><strong>Request total:</strong> {{total}} cp</p>
  <h3>Character currency (read-only)</h3>
  <ul>{{#each currency}}<li>{{@key}}: {{this}}</li>{{/each}}</ul>
  <p>Approval and rejection only record this request. No Items or currency transfer in Sprint 5.</p>
  <div class="dt-shop-controls"><button type="button" data-action="approve">Approve request</button>
    <button type="button" data-action="reject">Reject</button><button type="button" data-action="dismiss">Close</button></div>
</div>
