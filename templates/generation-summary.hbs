<section class="dt-generation-summary" aria-label="Generation summary">
  <h3>Generation Summary</h3>
  <dl><div><dt>Catalogues</dt><dd>{{summary.catalogues}}</dd></div><div><dt>Categories with products</dt><dd>{{summary.categories}}</dd></div>
    <div><dt>Unique products</dt><dd>{{summary.products}}</dd></div><div><dt>Catalogue services (reference)</dt><dd>{{summary.services}}</dd></div>
    <div><dt>RollTables to inspect</dt><dd>{{#if summary.tables}}{{summary.tables}}{{else}}Not built here{{/if}}</dd></div></dl>
  <p>{{summary.duration}}</p>
</section>
