{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devil's Table stock quantity policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles", "rules"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "profiles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "results"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "results": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["quantity", "weight"],
              "properties": {
                "quantity": { "type": "integer", "minimum": 1 },
                "weight": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["tier", "priceBand", "profile"],
        "properties": {
          "tier": { "type": "string", "enum": ["always", "often", "rarely"] },
          "priceBand": { "type": "string", "enum": ["Everyday", "Common", "Equipment", "Specialist"] },
          "profile": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
