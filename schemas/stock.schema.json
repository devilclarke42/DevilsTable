{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devil's Table stock profiles v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oftenChance",
    "rarelyChance",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "oftenChance": {
      "type": "integer",
      "minimum": 1
    },
    "rarelyChance": {
      "type": "integer",
      "minimum": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "shop",
          "coverage",
          "draws",
          "categoryDraws",
          "categories",
          "overrides"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DT_TABLE_[A-Z0-9]+(?:_[A-Z0-9]+)*$"
          },
          "shop": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ]
          },
          "draws": {
            "type": "integer",
            "minimum": 1
          },
          "categoryDraws": {
            "type": "integer",
            "minimum": 1
          },
          "categories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId",
                "tier"
              ],
              "properties": {
                "itemId": {
                  "type": "string",
                  "pattern": "^DT_ITEM_[A-Z0-9]+(?:_[A-Z0-9]+)+$"
                },
                "tier": {
                  "type": "string",
                  "enum": [
                    "always",
                    "often",
                    "rarely"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
