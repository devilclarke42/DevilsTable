{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devil's Table canonical item v1",
  "description": "Plain-text descriptions, 2014 mechanics, and author-supplied adjusted weights in pounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "saleUnit", "price", "weight", "icon", "category", "tags", "shops", "availability", "source", "mechanics"],
  "properties": {
    "id": { "type": "string", "pattern": "^DT_ITEM_[A-Z0-9]+(?:_[A-Z0-9]+)+$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "description": { "type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S" },
    "saleUnit": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
    "price": {
      "type": "object", "additionalProperties": false, "required": ["value", "denomination"],
      "properties": {
        "value": { "type": "integer", "minimum": 1 },
        "denomination": { "type": "string", "enum": ["cp", "sp", "gp"] }
      }
    },
    "weight": {
      "type": "object", "additionalProperties": false, "required": ["value", "units", "notes"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "units": { "type": "string", "const": "lb" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" }
      }
    },
    "icon": { "type": "string", "pattern": "^(icons/|modules/devils-table/assets/)[A-Za-z0-9_/-]+\\.(svg|webp|png|jpg|jpeg)$" },
    "category": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "shops": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
    "availability": { "type": "string", "enum": ["core", "variable", "special-order"] },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["title", "reference", "license"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
        "reference": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "license": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" }
      }
    },
    "mechanics": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["loot", "container", "consumable"] },
        "subtype": { "type": "string", "enum": ["art", "gear", "gem", "junk", "material", "resource", "trade", "treasure", "food", "trinket"] },
        "use": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "mode", "activation", "condition"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
            "mode": { "type": "string", "enum": ["consume", "reusable"] },
            "activation": { "type": "string", "enum": ["action", "special"] },
            "condition": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
          }
        },
        "light": {
          "type": "object", "additionalProperties": false,
          "required": ["brightFeet", "dimFeet", "shape", "durationHours", "fuel"],
          "properties": {
            "brightFeet": { "type": "integer", "minimum": 1 },
            "dimFeet": { "type": "integer", "minimum": 1 },
            "shape": { "type": "string", "enum": ["radius", "cone"] },
            "durationHours": { "type": "number", "minimum": 0 },
            "fuel": { "type": "string", "enum": ["self", "candle", "oil"] }
          }
        },
        "capacity": {
          "type": "object", "additionalProperties": false, "required": ["weight", "volume"],
          "properties": {
            "weight": {
              "type": "object", "additionalProperties": false, "required": ["value", "units"],
              "properties": { "value": { "type": "number", "minimum": 0 }, "units": { "type": "string", "const": "lb" } }
            },
            "volume": {
              "type": "object", "additionalProperties": false, "required": ["value", "units"],
              "properties": {
                "value": { "type": "number", "minimum": 0 },
                "units": { "type": "string", "enum": ["cubicFoot", "pint", "quart", "gallon"] }
              }
            }
          }
        }
      }
    }
  }
}
