{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devil's Table shop definitions v1",
  "type": "array", "minItems": 1,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "name", "description", "merchantNotes"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
      "description": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
      "merchantNotes": {
        "type": "object", "additionalProperties": false,
        "required": ["alwaysStocks", "oftenStocks", "rarelyStocks"],
        "properties": {
          "alwaysStocks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" } },
          "oftenStocks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" } },
          "rarelyStocks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" } }
        }
      }
    }
  }
}
