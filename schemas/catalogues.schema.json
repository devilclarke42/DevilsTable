{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devil's Table catalogue definitions v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "icon",
      "sort",
      "categories",
      "fallbackCategory",
      "metadata"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "\\S"
      },
      "icon": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "sort": {
        "type": "integer",
        "minimum": 0
      },
      "categories": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "fallbackCategory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "icon"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "metadata": {
        "type": "object"
      }
    }
  }
}
